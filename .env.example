# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Plug n Pay Payment Gateway
# Get these credentials from your Plug n Pay merchant account
# https://www.plugnpay.com - Login to access Security Administration settings
PLUGNPAY_PUBLISHER_NAME=your_publisher_name_here
PLUGNPAY_PUBLISHER_PASSWORD=your_publisher_password_here

# Optional: Set to 'test' for test mode, 'live' for production
PLUGNPAY_MODE=test
